{
  "name": "rcm",
  "version": "1.0.7",
  "description": "Remote Connection Manager",
  "_updateHinweis": "Auto-Update laeuft ueber SMB (checkSmbUpdate in main.js), NICHT electron-updater. electron-updater ist stillgelegt, weil es nur http/https kann, kein file://SMB. Fuer spaeteren Webserver: build.publish.url auf http://server/pfad aendern, in main.js setupAutoUpdater() reaktivieren und checkSmbUpdate() deaktivieren.",
  "main": "main.js",
  "author": "Tobias Haase",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild",
    "build": "node setup-icon.js && electron-builder build --win",
    "build:portable": "node setup-icon.js && electron-builder build --win portable",
    "setup": "node setup-icon.js"
  },
  "keywords": [],
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^40.6.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.firma.rcm",
    "productName": "Remote Connection Manager",
    "copyright": "© 2025",
    "publish": [
      {
        "provider": "generic",
        "url": "file://De0924LTH/RCM_AUP",
        "channel": "latest"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/serialport/**",
      "node_modules/@serialport/**",
      "node_modules/bindings/**",
      "node_modules/node-addon-api/**",
      "**/*.node"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "vault-crypto.js",
      "assets/icon.ico",
      "locales/**/*",
      "index.html",
      "style.css",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/electron/dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remote Connection Manager",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/",
      "strictSSL": false
    }
  },
  "allowScripts": {
    "@serialport/bindings-cpp": true,
    "electron": true,
    "ssh2": true
  }
}